{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["./controllers", "./models", "./helpers", "./middlewares", "./routes"],
    "includePattern": ".js$",
    "excludePattern": "(node_modules/|docs)"
  },
  "plugins": [],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "readme": "./README.md"
  }
}
